rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Security Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@eduhunters.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // 1. EduHunters Site Cloud Sync Data (Courses, Carousel, Exam Batches)
    match /eduhunters_site/{document=**} {
      // Students and visitors can read courses and exam public listings
      allow read: if true;
      // Allow site configurations and admin synchronization
      allow write: if true;
    }

    // 2. Student Profiles & Registered Devices
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Orders & Invoices
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 4. Default deny-all for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
